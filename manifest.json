<!-- PWA Core -->
<link rel="manifest" href="/dop/manifest.json">
<meta name="theme-color" content="#1766C2">

<!-- iOS / Safari -->
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="الاعمال اليومية">
<link rel="apple-touch-icon" href="https://i.ibb.co/PsVt0MSx/Kyo-Tux-Aeon-Misc-Document-256.png">

<!-- Android Chrome -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="application-name" content="الاعمال اليومية">

<!-- RTL + Arabic -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

<!-- Prevent Phone Number Detection -->
<meta name="format-detection" content="telephone=no">
